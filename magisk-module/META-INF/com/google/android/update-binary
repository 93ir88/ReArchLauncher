#!/sbin/sh

# ─── ReArch Freeform Support — Magisk Module Installer ─────────────────────
# Enables Android freeform window mode system-wide at boot.
# Compatible with Magisk 20.4+ and KernelSU.

SKIPUNZIP=1

# Extract module files
unzip -o "$ZIPFILE" 'system/*' -d "$MODPATH" >&2

# Set permissions
set_perm_recursive "$MODPATH/system/bin" root root 0755 0755

# Write post-fs-data script (runs before system boots)
cat > "$MODPATH/post-fs-data.sh" << 'EOF'
#!/system/bin/sh
# Enable freeform windows before any activities start
settings put global enable_freeform_support 1
settings put global force_resizable_activities 1
# Grant ReArchLauncher its required permissions
pm grant com.rearch.launcher android.permission.WRITE_SECURE_SETTINGS 2>/dev/null
pm grant com.rearch.launcher android.permission.WRITE_SETTINGS 2>/dev/null
pm grant com.rearch.launcher android.permission.CHANGE_CONFIGURATION 2>/dev/null
pm grant com.rearch.launcher android.permission.SYSTEM_ALERT_WINDOW 2>/dev/null
EOF
chmod 755 "$MODPATH/post-fs-data.sh"

# Write service.sh (runs after boot complete)
cat > "$MODPATH/service.sh" << 'EOF'
#!/system/bin/sh
# Wait for boot to complete
while [ "$(getprop sys.boot_completed)" != "1" ]; do
    sleep 1
done

# Re-apply freeform settings (some devices reset on boot)
settings put global enable_freeform_support 1
settings put global force_resizable_activities 1

# Re-grant permissions (in case they were lost)
pm grant com.rearch.launcher android.permission.WRITE_SECURE_SETTINGS 2>/dev/null
pm grant com.rearch.launcher android.permission.WRITE_SETTINGS 2>/dev/null
pm grant com.rearch.launcher android.permission.CHANGE_CONFIGURATION 2>/dev/null

# Enable developer options if needed
settings put global development_settings_enabled 1
EOF
chmod 755 "$MODPATH/service.sh"

ui_print "- ReArch Freeform Support installed"
ui_print "- Freeform windows will be enabled on next boot"
ui_print "- ReArchLauncher will be granted system permissions"
